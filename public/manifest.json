{
  "manifest_version": 3,
  "name": "Slophighway",
  "description": "3D guitar/bass note highway that runs on top of Songsterr tabs, synced to its playback.",
  "version": "0.6.2",
  "permissions": ["storage"],
  "host_permissions": [
    "*://www.songsterr.com/*",
    "*://*.cloudfront.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.songsterr.com/*", "*://songsterr.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://www.songsterr.com/*", "*://songsterr.com/*"],
      "js": ["vendor/slopsmith/highway_3d.js", "content.js"],
      "css": ["assets/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/three/three.module.min.js"],
      "matches": ["*://www.songsterr.com/*", "*://songsterr.com/*"]
    }
  ],
  "action": {
    "default_title": "Slophighway"
  }
}
